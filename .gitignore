# The component is built by `build.sh` into `package/component.wasm`, which is
# committed on purpose (same rule as Orivo's `plugins/ryujinx`): only the
# compiler output changes when the sources change, and the digest in
# `package/manifest.json` is checked against it.
target/

# `node scripts/build.mjs` stages and packs here; only `dist/*.orivo-plugin`
# is ever published, and only as a release asset.
dist/

# Orivo's release signing key. The private key never enters git: sign.mjs
# takes it from here, and CI (if it ever signs) must supply it itself.
keys/

# Installed by `pnpm install` for the packaging scripts; the lockfile beside it
# is committed, this is not.
node_modules/

# macOS leaves one in every directory it has been looked at in Finder.
.DS_Store
